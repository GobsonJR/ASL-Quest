# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file (it is already in .gitignore).

# --- Database -----------------------------------------------------------
# Standard connection string. Recommended for production: PostgreSQL via psycopg3.
#   DATABASE_URL=postgresql+psycopg://asl_quest:changeme@localhost:5432/asl_quest
# Leave unset for local development to use the bundled SQLite database at
# data/asl_quest.db (no setup required). See DATABASE.md for details.
DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Secret key used to sign JWT access tokens. Set a long random value in production;
# the default in backend/settings.py is for local development only.
ASL_QUEST_SECRET_KEY=
# Access token lifetime in minutes (default: 10080 = 7 days).
ASL_QUEST_TOKEN_EXPIRE_MINUTES=
# Email address that is automatically granted the admin role on first login.
ASL_QUEST_BOOTSTRAP_ADMIN_EMAIL=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
ASL_QUEST_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- AURA (project-only ASL-Quest chatbot) ----------------------------------
# Provider: OpenRouter (https://openrouter.ai), via its OpenAI-compatible chat
# completions API. Create a free account and an API key at
# https://openrouter.ai/keys — OpenRouter's free-tier models (id suffixed
# ":free") work fine for AURA and cost nothing. Leave unset to disable AURA —
# it will respond with a setup message instead of crashing the app. Never
# commit a real key.
OPENROUTER_API_KEY=
# Model identifier passed to the provider (default: openrouter/free). Check
# https://openrouter.ai/models?max_price=0 for current free-tier model ids
# (e.g. an id ending in ":free") and set this to one of those.
CHATBOT_MODEL=
# Optional: override the provider's API endpoint (e.g. a corporate proxy or a
# different OpenAI-compatible endpoint). Leave unset for the default
# (OpenRouter's own chat completions API,
# https://openrouter.ai/api/v1/chat/completions).
CHATBOT_API_BASE_URL=

# --- Native/ASL Citizen training tooling (NOT required to run the app) -----
# Only read by src/asl_citizen/config.py and scripts/audit_asl_citizen.py, for
# retraining/auditing against a local copy of the licensed ASL Citizen
# dataset. Leave unset unless you are doing that; the running app (including
# POST /native/predict) never reads this. Defaults to D:\ASL_Citizen\ASL_Citizen.
ASL_CITIZEN_DATASET_ROOT=
